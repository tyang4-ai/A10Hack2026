# Axelrod backend settings. Copy to backend/.env (gitignored) and fill in.
# Real environment variables win over this file. Empty values mean "use the default".
# Never put AWS credentials here: locally boto3 uses your shell, on EC2 it uses the instance role.

# Storage: local (JSON and vault files under DATA_DIR) or aws (DynamoDB plus S3)
STORE=local
# AWS region. us-east-1 only
AWS_REGION=us-east-1
# Bedrock model or inference profile id for the large model (planner, drafter, summarizer, repairer)
MODEL_LARGE=
# Bedrock model or inference profile id for the small model (extractor, verifier, reviser, repairer)
MODEL_SMALL=
# Bedrock Guardrail id for the prompt-injection tripwire. Empty means scans are skipped
GUARDRAIL_ID=
# Guardrail version, for example 1
GUARDRAIL_VERSION=
# S3 bucket for the vault (aws mode)
VAULT_BUCKET=
# DynamoDB table for runs, partition key run_id (aws mode)
RUNS_TABLE=
# DynamoDB table for events, partition key run_id, sort key seq (aws mode)
EVENTS_TABLE=
# Folder for the local store and vault, relative to the repo root (local mode)
DATA_DIR=backend/.data
# Most small-model calls in flight at once
MAX_CONCURRENCY_SMALL=16
# Most large-model calls in flight at once
MAX_CONCURRENCY_LARGE=4
# Spend cap per run, in USD
BUDGET_USD=5.0
# USD per million tokens per model id, one line of JSON: {"<model id>": {"in": 1.0, "out": 5.0}}
PRICES_JSON=
# 1 answers every model call from the registered fakes (offline runs and tests), 0 calls Bedrock
FAKE_MODELS=0
# User-Agent on every fetch. SEC wants a contact in it: set that in your own env, keep emails out of the repo
HTTP_USER_AGENT="Axelrod/0.1 (hackathon research harness)"
# Optional shared key. When set, every API request needs the X-Axelrod-Key header
AXELROD_API_KEY=
# Dashboard base URL, so the CLI can print run links
PUBLIC_UI_URL=
# Seconds to sleep before each fetch in the live demo, 0 is off
DEMO_PACING=0
# Where the run fetches the planted test page S-010 (simulated) from: Axelrod's own API, route /test-pages/<name>.
# On EC2: <API Gateway invoke URL>/test-pages/injection.html. Empty keeps the raw GitHub URL in plan.json,
# which only answers once the repo is public
TEST_PAGE_URL=
