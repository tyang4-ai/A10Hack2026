{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "AWS_REGION": "us-east-1",
    "AWS_DEFAULT_REGION": "us-east-1",
    "AWS_PAGER": "",
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(py:*)",
      "Bash(.venv/Scripts/python:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(uv:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(uvicorn:*)",
      "Bash(git:*)",
      "Bash(aws:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(echo:*)",
      "Bash(sleep:*)",
      "Bash(timeout:*)",
      "Bash(jq:*)",
      "Bash(cd:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(aws iam create-access-key:*)",
      "Bash(aws iam create-user:*)",
      "Bash(aws iam create-login-profile:*)",
      "Bash(aws configure export-credentials:*)",
      "Bash(aws configure get:*)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'.claude','hooks','guard.py'), run_name='__main__')\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['CLAUDE_PROJECT_DIR'],'.claude','hooks','context.py'), run_name='__main__')\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
